# Provider LLM : google-genai (Gemini)
# Le SDK lit automatiquement GEMINI_API_KEY (ou GOOGLE_API_KEY) depuis l'env.
GEMINI_API_KEY=your-key-here
LLM_MODEL=gemini-3.1-flash-lite
LLM_MODEL_ROUTER=gemma-4-26b-a4b-it
LLM_MODEL_SYNTH=gemini-3.1-flash-lite
USE_LANGGRAPH=1
GEMINI_RPM_LIMIT=14
GEMMA_RPM_LIMIT=14

# LangSmith (observabilité multi-agents)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=peche-agent

# Données et serveur
DATA_DIR=./data
PECHE_HOST=127.0.0.1
PECHE_PORT=8000
