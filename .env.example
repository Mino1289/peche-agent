# Provider LLM : google-genai (Gemini) — optional if users bring their own key (BYOK)
GEMINI_API_KEY=

LLM_MODEL=gemini-3.5-flash-lite
LLM_MODEL_FALLBACK=gemini-3.1-flash-lite
# Budget de réflexion (tokens) du modèle principal ; visible dans Langfuse, jamais montré à l'utilisateur
LLM_THINKING_BUDGET=1024

# Données et serveur
DATA_DIR=./data
PECHE_HOST=127.0.0.1
PECHE_PORT=8000

# MCP HTTP on same port as UI when enabled: http://127.0.0.1:8000/mcp
MCP_ENABLED=0

# MCP stdio (Cursor / Claude Desktop): python -m peche.mcp

# Langfuse auto-hébergé en local (observabilité LLM) : traces des appels LLM, outils et contexte carte.
#   docker compose up -d   -> UI http://localhost:3100
# Le projet, l'utilisateur et ces clés sont créés au 1er démarrage du service (headless init) :
# aucune étape manuelle. Sans clés ici, le tracing de l'app est désactivé.
# Valeurs de dev local uniquement : changer les secrets (LANGFUSE_*_PASSWORD, _SALT,
# _ENCRYPTION_KEY = `openssl rand -hex 32`, _NEXTAUTH_SECRET) avant tout autre usage.
LANGFUSE_PUBLIC_KEY=pk-lf-peche-local
LANGFUSE_SECRET_KEY=sk-lf-peche-local
# App lancée hors Docker (python -m peche.api) -> localhost. Dans Docker, compose cible langfuse-web.
LANGFUSE_BASE_URL=http://localhost:3100
LANGFUSE_PORT=3100
LANGFUSE_USER_EMAIL=admin@peche.local
LANGFUSE_USER_PASSWORD=peche-local-admin
# Sépare les traces dans les dashboards (development, docker, production…)
LANGFUSE_TRACING_ENVIRONMENT=development
# Mettre à 0 pour couper le tracing sans retirer les clés
LANGFUSE_ENABLED=1
